#!/bin/sh

# Add Node.js to PATH (Windows Git Bash compatibility)
export PATH="/c/Program Files/nodejs:$PATH"

# TypeScript check — frontend (root)
echo "TypeScript check (frontend)..."
./node_modules/.bin/tsc --noEmit
if [ $? -ne 0 ]; then
  echo "TypeScript errors in frontend. Fix before committing."
  exit 1
fi

# TypeScript check — backend
echo "TypeScript check (backend)..."
(cd backend && ../node_modules/.bin/tsc --noEmit)
if [ $? -ne 0 ]; then
  echo "TypeScript errors in backend. Fix before committing."
  exit 1
fi

echo "Pre-commit checks passed."
